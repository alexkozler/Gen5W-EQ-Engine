[nemesis]
version=1.1
id=eqengine
name=EQ Engine
type=application
package-version=0.6.6
short-desc="10-band EQ and 48 kHz output for Android Auto"
detailed-desc="Accurate 10-band EQ with end-band shelves, live view, preamp, clip guard, presets and a seat delay, for Android Auto and Bluetooth audio. 48 kHz output: Android Auto plays unconverted. Loaded in memory at each start; nothing written to /system."
os="NEEV.USA.*"
models="any"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=apk
path=app/EQEngine.apk
package=com.eqengine.app
component=com.eqengine.app/com.eqengine.app.MainActivity

[service.0]
name=boot
kind=sh
path=bin/boot.sh
uid=root
mode=background
