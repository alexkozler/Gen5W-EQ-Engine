[nemesis]
version=1.2
id=eqengine
name=EQ Engine
favicon=favicon.png
type=application,service
package-version=0.7.7
short-desc="EQ for Android Auto and CarPlay, 48 kHz output"
detailed-desc="10-band EQ or 20-band parametric EQ, live view, preamp, clip guard, presets and seat delay for Android Auto, CarPlay and Bluetooth audio. 48 kHz output for Android Auto. Loaded in memory at each start. Restart the head unit after installing."
os="NEEV.USA.*,CEEV.USA.*,CEEV.CAN.*,IKFL.CAN.*"
models="any"
depends=""
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=apk
path=app/EQEngine.apk
package=com.eqengine.app
component=com.eqengine.app/com.eqengine.app.MainActivity

[service.0]
name=boot
kind=sh
path=bin/boot.sh
uid=root
mode=background
