[nemesis]
version=1.1
id=eqengine
name=EQ Engine
type=application
package-version=0.6.0
short-desc="10-band EQ for all music, incl. Android Auto"
detailed-desc="10-band EQ with accurate sliders, preamp, clip guard, presets and a seat delay, for all music. High-quality audio converter; Lab has a very high quality test. Loaded in memory at each start (nothing written to /system); failsafes turn it off."
os="NEEV.USA.*"
models="any"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=apk
path=app/EQEngine.apk
package=com.eqengine.app
component=com.eqengine.app/com.eqengine.app.MainActivity

[service.0]
name=boot
kind=sh
path=bin/boot.sh
uid=root
mode=background
