[nemesis]
version=1.1
id=eqengine
name=EQ Engine
type=application
package-version=0.7.5
short-desc="EQ for Android Auto and CarPlay, 48 kHz output"
detailed-desc="Accurate 10-band EQ or a 20-band parametric one, live view, preamp, clip guard, user presets and a seat delay, for Android Auto, CarPlay (wired and wireless) and Bluetooth audio. 48 kHz output for Android Auto. Loaded in memory at each start."
os="NEEV.USA.*"
models="any"
preinstall=scripts/pre.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=apk
path=app/EQEngine.apk
package=com.eqengine.app
component=com.eqengine.app/com.eqengine.app.MainActivity

[service.0]
name=boot
kind=sh
path=bin/boot.sh
uid=root
mode=background
